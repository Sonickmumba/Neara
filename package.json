{
  "name": "neara",
  "version": "1.0.0",
  "description": "A complete Express.js backend for the neara neighborhood community platform.",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "test": "npm run test:backend && cd views && npm test",
    "test:backend": "node --test test/**/*.test.js",
    "build": "npm install && cd views && npm install --include=dev && npm run build",
    "start": "node server.js",
    "db:init": "node db/initDb.js",
    "db:migrate:postgis": "node db/migratePostgis.js",
    "db:migrate:message-indexes": "node db/runSqlFile.js db/migration_message_indexes.sql"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sonickmumba/Neara.git"
  },
  "keywords": [],
  "author": "Sonick Mumba",
  "license": "ISC",
  "dependencies": {
    "africastalking": "^0.7.9",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.1",
    "nodemon": "^3.1.11",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.17.2",
    "resend": "^6.9.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "twilio": "^5.10.4",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7"
  }
}
